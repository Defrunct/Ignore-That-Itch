{
  "manifest_version": 3,

  "name": "Ignore That Itch",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "author": "Nick Defrunct",
  "homepage_url": "https://github.com/Defrunct/Ignore-That-Itch",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage"
  ],

  "options_ui": {
    "page": "options/options.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.itch.io/*"],
      "js": ["common.js", "cell.js", "page.js"],
      "css": ["common.css", "cell.css", "page.css"],
      "all_frames": true
    }
  ],

  "default_locale": "en",

  "browser_specific_settings": {
    "gecko": {
      "id": "ignore-that-itch@defrunct",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }

}
